# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase (Project Settings -> API Keys) --------------------------------
# Public: safe for the browser. RLS protects the data.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Publishable key (sb_publishable_...). The legacy "anon" JWT key also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SERVER ONLY. Bypasses RLS. Secret key (sb_secret_...) or legacy service_role key.
SUPABASE_SECRET_KEY=

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# IANA timezone used to display times when the viewer's timezone is unknown.
NEXT_PUBLIC_DEFAULT_TIMEZONE=Asia/Kolkata

# --- Email (Resend) — needed from Phase 7 ------------------------------------
# SERVER ONLY.
RESEND_API_KEY=
# Verified sender, e.g. "Startup Floor Connect <noreply@yourdomain.com>"
EMAIL_FROM=
